{
  "name": "vogler-maintenance-api",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev:migrate": "NODE_OPTIONS='-r tsx/cjs -r dotenv/config' knex --knexfile src/knexfile.ts migrate:latest",
    "dev:seed": "NODE_OPTIONS='-r tsx/cjs -r dotenv/config' knex --knexfile src/knexfile.ts seed:run",
    "migrate": "NODE_ENV=production knex --knexfile dist/knexfile.js migrate:latest",
    "migrate:rollback": "NODE_ENV=production knex --knexfile dist/knexfile.js migrate:rollback",
    "seed": "NODE_ENV=production knex --knexfile dist/knexfile.js seed:run",
    "create-admin": "tsx src/scripts/create-admin.ts",
    "create-admin:prod": "node dist/scripts/create-admin.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.12.0",
    "twilio": "^5.3.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.5.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.15",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
